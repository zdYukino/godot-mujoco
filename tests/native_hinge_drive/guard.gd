extends "res://pin_support.gd"
var callbacks:=0
func run():
 setup()
 var a:=body(Vector3.ZERO)
 PhysicsServer3D.body_set_param(a,PhysicsServer3D.BODY_PARAM_GRAVITY_SCALE,0.0)
 PhysicsServer3D.body_set_param(a,PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP,2.0)
 var j:=PhysicsServer3D.joint_create();joints.append(j)
 PhysicsServer3D.joint_make_hinge(j,a,Transform3D.IDENTITY,RID(),Transform3D.IDENTITY)
 PhysicsServer3D.body_set_state(a,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY,Vector3(0,0,1))
 PhysicsServer3D.body_apply_torque(a,Vector3(0,0,.016))
 PhysicsServer3D.body_set_force_integration_callback(a,func(_state):callbacks+=1)
 PhysicsServer3D.hinge_joint_set_param(j,PhysicsServer3D.HINGE_JOINT_MOTOR_TARGET_VELOCITY,100.0)
 PhysicsServer3D.hinge_joint_set_param(j,PhysicsServer3D.HINGE_JOINT_MOTOR_MAX_IMPULSE,1000.0)
 PhysicsServer3D.hinge_joint_set_flag(j,PhysicsServer3D.HINGE_JOINT_FLAG_ENABLE_MOTOR,true)
 var initial_pose:=pose(a)
 var before:Dictionary=PhysicsServer3D.call("scene_info",space)
 var request:int=PhysicsServer3D.call("scene_request_world_command",space,"step",1)
 var result:Dictionary={}
 print("EXPECT_DRIVE_ERROR Native Hinge drive numerical state rejected")
 for i in 30:
  await ticks()
  result=PhysicsServer3D.call("scene_world_command_result",request)
  if not result.is_empty():break
 await ticks(2)
 var after:Dictionary=PhysicsServer3D.call("scene_info",space)
 var angular:Vector3=PhysicsServer3D.body_get_state(a,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY)
 check(after.time==before.time,"guard no simulated time advance",after)
 check(after.paused,"guard leaves world paused",after)
 check(angular.is_equal_approx(Vector3(0,0,1)),"guard preserves pre-step velocity including unapplied damping",angular)
 check(pose(a).is_equal_approx(initial_pose),"guard leaves pose untouched",pose(a))
 check(callbacks==0,"guard does not emit fictitious integration callback",callbacks)
 check(not result.get("success",true),"guard does not report failed step as successful",result)
 check(abs(float(result.get("time",-1))-float(after.time))<1e-9,"completion time equals actual simulated time",result)
 PhysicsServer3D.hinge_joint_set_flag(j,PhysicsServer3D.HINGE_JOINT_FLAG_ENABLE_MOTOR,false)
 await step(1)
 angular=PhysicsServer3D.body_get_state(a,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY)
 check(abs(angular.z-.99)<.0001,"retry consumes original one-shot torque exactly once",angular)
 await finish("HINGE_GUARD_RESULT")
