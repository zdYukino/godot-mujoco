extends "res://acceptance.gd"
func expect(message:String):print("EXPECT_HINGE_ERROR ",message)
func run():
 setup()
 var a=body(Vector3.ZERO);var accepted=hinge(a,Transform3D.IDENTITY)
 for parameter in [PhysicsServer3D.HINGE_JOINT_BIAS,PhysicsServer3D.HINGE_JOINT_LIMIT_BIAS,PhysicsServer3D.HINGE_JOINT_LIMIT_SOFTNESS,PhysicsServer3D.HINGE_JOINT_LIMIT_RELAXATION]:
  var old=PhysicsServer3D.hinge_joint_get_param(accepted,parameter)
  expect("Native Hinge custom solver response unsupported")
  PhysicsServer3D.hinge_joint_set_param(accepted,parameter,old+.1)
  check(PhysicsServer3D.hinge_joint_get_param(accepted,parameter)==old,"unsupported parameter retains compatibility default %s"%parameter)
 var old_pose=pose(a);var old_velocity=velocity(a);var old_time:float=PhysicsServer3D.call("scene_info",space).time
 expect("Native passive Hinge requires finite rigid frames")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D(Basis(Vector3.RIGHT,Vector3.UP,Vector3.ZERO),Vector3.ZERO),RID(),Transform3D.IDENTITY)
 expect("Native passive Hinge requires finite rigid frames")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D(Basis.IDENTITY,Vector3(NAN,0,0)),RID(),Transform3D.IDENTITY)
 expect("Native passive Hinge initially misaligned world axes unsupported")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D.IDENTITY,RID(),frame(Vector3.RIGHT,Vector3.ZERO))
 expect("Native passive Hinge requires finite rigid frames")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D(Basis.from_scale(Vector3(2,1,1)),Vector3.ZERO),RID(),Transform3D.IDENTITY)
 expect("Native passive Hinge auxiliary anchor not representable")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D(Basis.IDENTITY,Vector3(0,0,1e20)),RID(),Transform3D.IDENTITY)
 expect("Native Pin candidate rejected; previous model retained")
 PhysicsServer3D.joint_make_hinge(accepted,a,Transform3D(Basis.IDENTITY,Vector3(1e20,0,0)),RID(),Transform3D.IDENTITY)
 check(PhysicsServer3D.joint_get_type(accepted)==PhysicsServer3D.JOINT_TYPE_HINGE,"failed replacements keep hinge type")
 check(pose(a).is_equal_approx(old_pose) and velocity(a).is_equal_approx(old_velocity),"failed replacements preserve live pose and velocity")
 var info:Dictionary=PhysicsServer3D.call("scene_info",space)
 check(info.paused and info.time==old_time,"failed replacements preserve pause and simulation time")
 PhysicsServer3D.body_apply_torque_impulse(a,Vector3(0,0,.032));await step(30)
 check(pose(a).origin.length()<.03 and pose(a).basis.z.dot(Vector3.BACK)>.999 and abs(angular(a).z)>1.5,"old hinge still physically constrains and spins after rejected replacements")
 await finish("HINGE_NEGATIVE_RESULT")
