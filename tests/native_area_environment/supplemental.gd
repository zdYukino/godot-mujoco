extends "res://acceptance.gd"
# Complementary checks only: original acceptance already tests each channel alone.
func modes(area:RID,gravity:int,linear:int,angular:int):
 ap(area,PhysicsServer3D.AREA_PARAM_GRAVITY_OVERRIDE_MODE,gravity)
 ap(area,PhysicsServer3D.AREA_PARAM_LINEAR_DAMP_OVERRIDE_MODE,linear)
 ap(area,PhysicsServer3D.AREA_PARAM_ANGULAR_DAMP_OVERRIDE_MODE,angular)
func sampled(expected_g:Vector3,ld:float,ad:float,label:String):
 reset(Vector3(10,0,0),Vector3(0,10,0));await step()
 near(velocity(),Vector3(10*(1-ld*.01),0,0)+expected_g*.01,label+" physical linear velocity")
 near(PhysicsServer3D.body_get_state(body,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY),Vector3(0,10*(1-ad*.01),0),label+" physical angular velocity")
 var state=PhysicsServer3D.body_get_direct_state(body)
 near(state.total_gravity,expected_g,label+" sampled gravity")
 check(abs(state.total_linear_damp-ld)<.0001 and abs(state.total_angular_damp-ad)<.0001,label+" sampled damping agrees with physical effect")
func run():
 space=PhysicsServer3D.space_create();owned.append(space);PhysicsServer3D.space_set_active(space,true);PhysicsServer3D.call("scene_pause",space,true)
 var file=FileAccess.open("res://supplemental.xml",FileAccess.WRITE);file.store_string('<mujoco><option timestep=".01" gravity="0 0 -10" integrator="Euler"/><worldbody/></mujoco>');file.close()
 var doc:RefCounted=ClassDB.instantiate("MjEditorDocument")
 check(doc.import_file("res://supplemental.xml") and PhysicsServer3D.call("scene_configure_model",space,doc.snapshot(),"res://"),"supplemental exact-step world")
 ap(space,PhysicsServer3D.AREA_PARAM_LINEAR_DAMP,1.0);ap(space,PhysicsServer3D.AREA_PARAM_ANGULAR_DAMP,2.0)
 field_shape=PhysicsServer3D.box_shape_create();owned.append(field_shape);PhysicsServer3D.shape_set_data(field_shape,Vector3.ONE*5)
 var ball=PhysicsServer3D.sphere_shape_create();owned.append(ball);PhysicsServer3D.shape_set_data(ball,.25)
 body=PhysicsServer3D.body_create();owned.append(body);PhysicsServer3D.body_add_shape(body,ball);PhysicsServer3D.body_set_space(body,space)
 bp(PhysicsServer3D.BODY_PARAM_LINEAR_DAMP,.5);bp(PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP,1.0)
 var low=field(0,Vector3(0,3,0),7,8);var high=field(10,Vector3(2,0,0),5,6);var top=field(20,Vector3(0,0,4),3,4)
 modes(top,1,2,0);modes(high,3,1,4)
 await sampled(Vector3(2,0,0),3.5,17.0,"mixed gravity REPLACE linear COMBINE_REPLACE angular REPLACE_COMBINE")
 modes(top,0,4,1);modes(high,2,0,3)
 await sampled(Vector3(2,0,0),11.5,7.0,"mixed gravity COMBINE_REPLACE linear REPLACE_COMBINE angular REPLACE")
 modes(top,2,0,2);modes(high,4,3,4)
 await sampled(Vector3(0,0,4),5.5,5.0,"channel stop flags remain independent")
 for area in [low,high,top]:PhysicsServer3D.free_rid(area);owned.erase(area)
 var first=field(10,Vector3(2,0,0),3,4);var second=field(10,Vector3(0,3,0),5,6)
 modes(first,3,3,3);modes(second,3,3,3)
 var first_wins=first.get_id()<second.get_id()
 var expected=Vector3(2,0,0) if first_wins else Vector3(0,3,0)
 var expected_ld=3.5 if first_wins else 5.5;var expected_ad=5.0 if first_wins else 7.0
 await sampled(expected,expected_ld,expected_ad,"equal priority resolves by ascending RID")
 PhysicsServer3D.area_set_space(first,RID());PhysicsServer3D.area_set_space(first,space)
 await sampled(expected,expected_ld,expected_ad,"equal priority stable after first Area detach/readd")
 bp(PhysicsServer3D.BODY_PARAM_FRICTION,.7);PhysicsServer3D.call("scene_pause",space,true)
 await sampled(expected,expected_ld,expected_ad,"equal priority stable after unrelated native rebuild")
 PhysicsServer3D.free_rid(second);owned.erase(second)
 modes(first,3,0,0)
 bp(PhysicsServer3D.BODY_PARAM_LINEAR_DAMP_MODE,1);bp(PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP_MODE,1)
 bp(PhysicsServer3D.BODY_PARAM_LINEAR_DAMP,0.0);bp(PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP,0.0)
 PhysicsServer3D.area_set_transform(first,Transform3D(Basis(Vector3.BACK,PI/2),Vector3(1,2,0)))
 ap(first,PhysicsServer3D.AREA_PARAM_GRAVITY_IS_POINT,true)
 ap(first,PhysicsServer3D.AREA_PARAM_GRAVITY_VECTOR,Vector3(2,0,1))
 ap(first,PhysicsServer3D.AREA_PARAM_GRAVITY,8.0)
 ap(first,PhysicsServer3D.AREA_PARAM_GRAVITY_POINT_UNIT_DISTANCE,2.0)
 reset(Vector3.ZERO,Vector3.ZERO,Vector3(1,0,1));await step()
 near(velocity(),Vector3(0,.02,0),"rotated translated local point center with inverse square distance")
 near(PhysicsServer3D.body_get_direct_state(body).total_gravity,Vector3(0,2,0),"rotated point sampled field matches actual acceleration")
 ap(first,PhysicsServer3D.AREA_PARAM_GRAVITY_POINT_UNIT_DISTANCE,0.0)
 reset(Vector3.ZERO,Vector3.ZERO,Vector3(1,0,1));await step()
 near(velocity(),Vector3(0,.08,0),"rotated local center constant magnitude branch")
 # Use a center computed with the same authored transform to avoid float-rotation
 # rounding turning an exact zero-distance case into a near-singularity test.
 var center=Transform3D(Basis(Vector3.BACK,PI/2),Vector3(1,2,0))*Vector3(2,0,1)
 reset(Vector3.ZERO,Vector3.ZERO,center);await step()
 near(velocity(),Vector3.ZERO,"rotated point exact center gives zero acceleration")
 owned.reverse()
 for rid in owned:PhysicsServer3D.free_rid(rid)
 owned.clear();await frames()
 print("AREA_ENVIRONMENT_SUPPLEMENTAL_RESULT ",JSON.stringify({"passed":passed,"failed":failed}))
 quit(0 if failed==0 else 1)
