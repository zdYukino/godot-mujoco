extends "res://acceptance.gd"
func expect(message:String):print("EXPECT_PIN_ERROR ",message)
func run():
 setup()
 var a=body(Vector3(0,-1,0));var accepted=pin(a,Vector3.UP)
 for pair in [[PhysicsServer3D.PIN_JOINT_BIAS,.4],[PhysicsServer3D.PIN_JOINT_DAMPING,2.0],[PhysicsServer3D.PIN_JOINT_IMPULSE_CLAMP,1.0]]:
  var old=PhysicsServer3D.pin_joint_get_param(accepted,pair[0])
  expect("Native Pin uses fixed MuJoCo soft constraint response")
  PhysicsServer3D.pin_joint_set_param(accepted,pair[0],pair[1])
  check(PhysicsServer3D.pin_joint_get_param(accepted,pair[0])==old,"unsupported Pin response parameter not falsely stored")
 var old_anchor=PhysicsServer3D.pin_joint_get_local_a(accepted)
 expect("Native Pin requires finite anchors")
 PhysicsServer3D.pin_joint_set_local_a(accepted,Vector3(NAN,0,0))
 check(PhysicsServer3D.pin_joint_get_local_a(accepted)==old_anchor,"nonfinite anchor retains accepted definition")
 expect("Native Pin requires finite anchors")
 PhysicsServer3D.joint_make_pin(accepted,a,Vector3.ZERO,a,Vector3.ZERO)
 check(PhysicsServer3D.joint_get_type(accepted)==PhysicsServer3D.JOINT_TYPE_PIN and PhysicsServer3D.pin_joint_get_local_a(accepted)==old_anchor,"self joint rejects without replacing accepted Pin")
 var other=body(Vector3(4,0,0));var other_space=PhysicsServer3D.space_create();resources.append(other_space)
 PhysicsServer3D.body_set_space(other,other_space)
 expect("Native Pin requires finite anchors")
 PhysicsServer3D.joint_make_pin(accepted,a,Vector3.ZERO,other,Vector3.ZERO)
 check(PhysicsServer3D.pin_joint_get_local_a(accepted)==old_anchor,"cross-space replacement preserves old anchor")
 var duplicate=PhysicsServer3D.joint_create();joints.append(duplicate)
 expect("Native Pin closed loops and duplicate edges are unsupported")
 PhysicsServer3D.joint_make_pin(duplicate,a,Vector3.UP,RID(),Vector3.ZERO)
 check(PhysicsServer3D.joint_get_type(duplicate)==PhysicsServer3D.JOINT_TYPE_MAX,"duplicate edge rejected before mutation")
 var b=body(Vector3(.5,-1,0));pin(b,Vector3.ZERO,a,Vector3(.5,0,0))
 var loop=PhysicsServer3D.joint_create();joints.append(loop)
 expect("Native Pin closed loops and duplicate edges are unsupported")
 PhysicsServer3D.joint_make_pin(loop,b,Vector3.UP,RID(),Vector3(.5,0,0))
 check(PhysicsServer3D.joint_get_type(loop)==PhysicsServer3D.JOINT_TYPE_MAX,"closed world loop rejected before mutation")
 expect("Native joint custom solver priority unsupported")
 PhysicsServer3D.joint_set_solver_priority(accepted,2)
 check(PhysicsServer3D.joint_get_solver_priority(accepted)==1,"unsupported priority not falsely stored")
 await step(30)
 check((pose(a)*Vector3.UP).length()<.03,"accepted old Pin still physically constrains after all rejected replacements")
 var stable_pose=pose(a);var stable_velocity=velocity(a);var stable_info:Dictionary=PhysicsServer3D.call("scene_info",space)
 expect("Native Pin candidate rejected; previous model retained")
 PhysicsServer3D.pin_joint_set_local_a(accepted,Vector3(1e20,0,0))
 check(PhysicsServer3D.joint_get_type(accepted)==PhysicsServer3D.JOINT_TYPE_PIN and PhysicsServer3D.pin_joint_get_local_a(accepted)==old_anchor,"finite unsafe candidate leaves old joint definition")
 check(pose(a).is_equal_approx(stable_pose) and velocity(a).is_equal_approx(stable_velocity),"finite unsafe candidate preserves active body pose and velocity")
 var after_info:Dictionary=PhysicsServer3D.call("scene_info",space)
 check(after_info.paused==stable_info.paused and after_info.time==stable_info.time,"finite unsafe candidate preserves pause and simulation time")
 var callback_body=body(Vector3(30,-1,0));var callback_joint=PhysicsServer3D.joint_create();joints.append(callback_joint)
 PhysicsServer3D.body_set_force_integration_callback(callback_body,func(_state):
  if sequence_done:return
  sequence_done=true
  PhysicsServer3D.body_set_mode(callback_body,PhysicsServer3D.BODY_MODE_STATIC)
  expect("Native Pin requires finite anchors")
  PhysicsServer3D.joint_make_pin(callback_joint,callback_body,Vector3.UP,RID(),Vector3(30,0,0)))
 await step(1);await ticks(2)
 check(sequence_done and PhysicsServer3D.body_get_mode(callback_body)==PhysicsServer3D.BODY_MODE_STATIC and PhysicsServer3D.joint_get_type(callback_joint)==PhysicsServer3D.JOINT_TYPE_MAX,"callback mode then make validates new mode and rejects static-world")
 var kinematic=body(Vector3(50,0,0),PhysicsServer3D.BODY_MODE_KINEMATIC)
 expect("Native Pin requires finite anchors")
 PhysicsServer3D.joint_make_pin(accepted,a,Vector3.ZERO,kinematic,Vector3.ZERO)
 check(PhysicsServer3D.joint_get_type(accepted)==PhysicsServer3D.JOINT_TYPE_PIN and PhysicsServer3D.pin_joint_get_local_a(accepted)==old_anchor,"new kinematic mode does not silently expand Pin endpoint contract")
 await finish("PIN_NEGATIVE_RESULT")
