extends "res://acceptance.gd"
func expected(message: String) -> void: print("EXPECT_NATIVE_ERROR ", message)
func run() -> void:
 var space := PhysicsServer3D.space_create(); owned.append(space)
 PhysicsServer3D.space_set_active(space, true)
 check(PhysicsServer3D.call("scene_pause", space, true), "negative space paused")
 var fixture := FileAccess.open("res://negative.xml", FileAccess.WRITE)
 fixture.store_string('<mujoco><option timestep=".01" gravity="0 0 0"/><worldbody/></mujoco>');fixture.close()
 var document: RefCounted = ClassDB.instantiate("MjEditorDocument")
 check(document.import_file("res://negative.xml") and PhysicsServer3D.call("scene_configure_model", space, document.snapshot(), "res://"), "negative fixture configured")
 var body := make_body(space)
 for pair in [[PhysicsServer3D.BODY_PARAM_MASS, 0.0, "value <= 0"], [PhysicsServer3D.BODY_PARAM_GRAVITY_SCALE, NAN, "!std::isfinite(value)"], [PhysicsServer3D.BODY_PARAM_FRICTION, INF, "!std::isfinite(value)"], [PhysicsServer3D.BODY_PARAM_LINEAR_DAMP, -1.0, "value < 0"], [PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP, -1.0, "value < 0"], [PhysicsServer3D.BODY_PARAM_LINEAR_DAMP_MODE, 2, "value != 0 && value != 1"]]:
  var previous: Variant = PhysicsServer3D.body_get_param(body,pair[0])
  expected(pair[2]);param(body,pair[0],pair[1])
  check(PhysicsServer3D.body_get_param(body,pair[0])==previous, "invalid parameter preserves previous value %s"%pair[0])
 for pair in [[PhysicsServer3D.BODY_PARAM_BOUNCE, .5, 0.0], [PhysicsServer3D.BODY_PARAM_INERTIA, Vector3.ONE, Vector3.ZERO], [PhysicsServer3D.BODY_PARAM_CENTER_OF_MASS, Vector3.ONE, Vector3.ZERO]]:
  param(body,pair[0],pair[1])
  check(PhysicsServer3D.body_get_param(body,pair[0])==pair[2], "unsupported parameter is not falsely stored %s"%pair[0])
 set_velocity(body, Vector3(1,2,3), Vector3(0,0,2))
 expected('v.get_type() != Variant::VECTOR3 || !Vector3(v).is_finite()')
 PhysicsServer3D.body_set_state(body,PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY,Vector3(NAN,0,0))
 near(velocity(body),Vector3(1,2,3),"nonfinite velocity rejected")
 expected('!v.is_finite() || !p.is_finite()')
 PhysicsServer3D.body_apply_impulse(body,Vector3(2,0,0),Vector3(INF,0,0))
 near(velocity(body),Vector3(1,2,3),"invalid offset impulse no partial linear mutation")
 near(angular(body),Vector3(0,0,2),"invalid offset impulse no partial angular mutation")
 PhysicsServer3D.body_set_constant_force(body,Vector3(2,0,0))
 PhysicsServer3D.body_set_constant_torque(body,Vector3(0,0,1))
 expected('!v.is_finite() || !p.is_finite()')
 PhysicsServer3D.body_add_constant_force(body,Vector3(0,20,0),Vector3(NAN,0,0))
 near(PhysicsServer3D.body_get_constant_force(body),Vector3(2,0,0),"invalid constant offset force leaves force unchanged")
 near(PhysicsServer3D.body_get_constant_torque(body),Vector3(0,0,1),"invalid constant offset force leaves torque unchanged")
 expected('!v.is_finite()')
 PhysicsServer3D.body_set_constant_force(body,Vector3(NAN,0,0))
 near(PhysicsServer3D.body_get_constant_force(body),Vector3(2,0,0),"nonfinite constant setter preserves value")
 PhysicsServer3D.body_set_constant_force(body,Vector3.ZERO)
 PhysicsServer3D.body_set_constant_torque(body,Vector3.ZERO)
 set_velocity(body,Vector3.ZERO)
 PhysicsServer3D.body_apply_central_force(body,Vector3(2,0,0))
 expected('!v.is_finite() || !p.is_finite()')
 PhysicsServer3D.body_apply_force(body,Vector3(0,20,0),Vector3(INF,0,0))
 await step(space)
 near(velocity(body),Vector3(.01,0,0),"invalid one-shot offset force leaves original physical force only")
 near(angular(body),Vector3.ZERO,"invalid one-shot offset force leaves no torque")
 var ordinary_space := PhysicsServer3D.space_create(); owned.append(ordinary_space)
 PhysicsServer3D.area_set_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY,10.0)
 PhysicsServer3D.area_set_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY_VECTOR,Vector3.DOWN)
 for invalid in [INF,1e300]:
  expected('!std::isfinite(double(v))||!std::isfinite(float(double(v)))')
  PhysicsServer3D.area_set_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY,invalid)
  check(PhysicsServer3D.area_get_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY)==10.0,"invalid default area gravity preserved")
 expected('!(gravity_direction*gravity).is_finite()')
 PhysicsServer3D.area_set_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY_VECTOR,Vector3(2e38,0,0))
 check(PhysicsServer3D.area_get_param(ordinary_space,PhysicsServer3D.AREA_PARAM_GRAVITY_VECTOR)==Vector3.DOWN,"derived default gravity overflow preserves direction")
 expected('!std::isfinite(value)||!std::isfinite(float(value))')
 param(body,PhysicsServer3D.BODY_PARAM_GRAVITY_SCALE,1e308)
 check(PhysicsServer3D.body_get_param(body,PhysicsServer3D.BODY_PARAM_GRAVITY_SCALE)==0.0,"finite double outside float range preserves gravity scale")
 var probe := make_body(ordinary_space)
 for parameters in [[PhysicsServer3D.BODY_PARAM_LINEAR_DAMP,PhysicsServer3D.BODY_PARAM_LINEAR_DAMP_MODE,PhysicsServer3D.AREA_PARAM_LINEAR_DAMP],[PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP,PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP_MODE,PhysicsServer3D.AREA_PARAM_ANGULAR_DAMP]]:
  var damp: int = parameters[0];var mode: int = parameters[1];var area_damp: int = parameters[2]
  PhysicsServer3D.area_set_param(ordinary_space,area_damp,2e38)
  param(probe,mode,PhysicsServer3D.BODY_DAMP_MODE_COMBINE)
  expected('selected==0&&!std::isfinite(float(amount+(angular?s->angular_damp:s->linear_damp)))')
  param(probe,damp,2e38)
  check(PhysicsServer3D.body_get_param(probe,damp)==0.0,"overflowing combined body damping preserves amount %s"%damp)
  param(probe,mode,PhysicsServer3D.BODY_DAMP_MODE_REPLACE)
  param(probe,damp,2e38)
  expected('selected==0&&!std::isfinite(float(amount+(angular?s->angular_damp:s->linear_damp)))')
  param(probe,mode,PhysicsServer3D.BODY_DAMP_MODE_COMBINE)
  check(PhysicsServer3D.body_get_param(probe,mode)==PhysicsServer3D.BODY_DAMP_MODE_REPLACE,"overflowing mode switch preserves REPLACE %s"%mode)
  PhysicsServer3D.body_set_space(probe,space)
  param(probe,mode,PhysicsServer3D.BODY_DAMP_MODE_COMBINE)
  expected('int(_body_get_param(r,mode))==0&&!std::isfinite(float(double(_body_get_param(r,damp))+(angular?target->angular_damp:target->linear_damp)))')
  PhysicsServer3D.body_set_space(probe,ordinary_space)
  check(PhysicsServer3D.body_get_space(probe)==space,"overflowing damping on destination retains original space %s"%damp)
  param(probe,damp,0.0)
  param(probe,mode,PhysicsServer3D.BODY_DAMP_MODE_REPLACE)
  PhysicsServer3D.body_set_space(probe,ordinary_space)
 owned.reverse()
 for rid in owned: PhysicsServer3D.free_rid(rid)
 owned.clear()
 await frames(2)
 var failed := checks.filter(func(item): return not item.passed).size()
 print("NATIVE_SEMANTICS_NEGATIVE_RESULT ",JSON.stringify({"passed":checks.size()-failed,"failed":failed,"checks":checks}))
 quit(0 if failed==0 else 1)
