extends "res://pin_support.gd"
# Composition test, not a replacement for Capsule/Area/Hinge feature suites.
func capsule(at:Vector3)->RID:
 var shape=PhysicsServer3D.capsule_shape_create();resources.append(shape)
 PhysicsServer3D.shape_set_data(shape,{"radius":.2,"height":1.0})
 var id=PhysicsServer3D.body_create();resources.append(id)
 PhysicsServer3D.body_set_mode(id,PhysicsServer3D.BODY_MODE_RIGID)
 PhysicsServer3D.body_add_shape(id,shape)
 PhysicsServer3D.body_set_param(id,PhysicsServer3D.BODY_PARAM_LINEAR_DAMP,.5)
 PhysicsServer3D.body_set_param(id,PhysicsServer3D.BODY_PARAM_ANGULAR_DAMP,.25)
 PhysicsServer3D.body_set_state(id,PhysicsServer3D.BODY_STATE_TRANSFORM,Transform3D(Basis.IDENTITY,at))
 PhysicsServer3D.body_set_space(id,space)
 return id
func near(actual:Vector3,expected:Vector3,label:String):check(actual.distance_to(expected)<.0002,label,{"actual":actual,"expected":expected})
func run():
 setup()
 var area_shape=PhysicsServer3D.capsule_shape_create();resources.append(area_shape)
 PhysicsServer3D.shape_set_data(area_shape,{"radius":8.0,"height":20.0})
 var area=PhysicsServer3D.area_create();resources.append(area)
 PhysicsServer3D.area_add_shape(area,area_shape);PhysicsServer3D.area_set_space(area,space)
 PhysicsServer3D.area_set_param(area,PhysicsServer3D.AREA_PARAM_GRAVITY,6.0)
 PhysicsServer3D.area_set_param(area,PhysicsServer3D.AREA_PARAM_GRAVITY_VECTOR,Vector3.RIGHT)
 PhysicsServer3D.area_set_param(area,PhysicsServer3D.AREA_PARAM_LINEAR_DAMP,2.0)
 PhysicsServer3D.area_set_param(area,PhysicsServer3D.AREA_PARAM_ANGULAR_DAMP,3.0)
 for parameter in [PhysicsServer3D.AREA_PARAM_GRAVITY_OVERRIDE_MODE,PhysicsServer3D.AREA_PARAM_LINEAR_DAMP_OVERRIDE_MODE,PhysicsServer3D.AREA_PARAM_ANGULAR_DAMP_OVERRIDE_MODE]:PhysicsServer3D.area_set_param(area,parameter,3)
 var free_body=capsule(Vector3.ZERO)
 PhysicsServer3D.body_set_state(free_body,PhysicsServer3D.BODY_STATE_LINEAR_VELOCITY,Vector3(2,0,0))
 PhysicsServer3D.body_set_state(free_body,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY,Vector3(0,4,0))
 await step(1)
 near(velocity(free_body),Vector3(2.01,0,0),"Capsule Area applies real replacement gravity plus damping to Capsule body")
 near(PhysicsServer3D.body_get_state(free_body,PhysicsServer3D.BODY_STATE_ANGULAR_VELOCITY),Vector3(0,3.87,0),"Capsule Area applies angular damping to Capsule body")
 var free_state=PhysicsServer3D.body_get_direct_state(free_body)
 near(free_state.total_gravity,Vector3(6,0,0),"Capsule overlap samples Area gravity")
 var constrained=capsule(Vector3(3,-1,0));var joint=PhysicsServer3D.joint_create();joints.append(joint)
 PhysicsServer3D.joint_make_hinge(joint,constrained,Transform3D(Basis.IDENTITY,Vector3.UP),RID(),Transform3D(Basis.IDENTITY,Vector3(3,0,0)))
 check(PhysicsServer3D.joint_get_type(joint)==PhysicsServer3D.JOINT_TYPE_HINGE,"Capsule body accepts passive Hinge")
 await step(20)
 check((pose(constrained)*Vector3.UP).distance_to(Vector3(3,0,0))<.03,"Hinge anchor resists transverse Area acceleration")
 check(pose(constrained).origin.x>3.05 and not pose(constrained).basis.is_equal_approx(Basis.IDENTITY),"Area force drives actual constrained Capsule swing")
 near(PhysicsServer3D.body_get_direct_state(constrained).total_gravity,Vector3(6,0,0),"constraint does not suppress Area gravity sample")
 PhysicsServer3D.joint_clear(joint)
 var before=velocity(constrained);var anchor_before=pose(constrained)*Vector3.UP
 await step(10)
 near(velocity(constrained),before*.75+Vector3(.6,0,0),"clear Hinge restores free Capsule Area acceleration and damping")
 check((pose(constrained)*Vector3.UP).distance_to(anchor_before)>.03,"cleared Capsule leaves old anchor")
 # Recreate, then delete the joint RID: separate lifecycle route, same field.
 var new_anchor=pose(constrained)*Vector3.UP
 var current_basis=pose(constrained).basis
 PhysicsServer3D.joint_make_hinge(joint,constrained,Transform3D(Basis.IDENTITY,Vector3.UP),RID(),Transform3D(current_basis,new_anchor))
 await step(10)
 check((pose(constrained)*Vector3.UP).distance_to(new_anchor)<.03,"Capsule Hinge readdition restores constraint within Area")
 PhysicsServer3D.free_rid(joint);joints.erase(joint)
 before=velocity(constrained);await step(10)
 near(velocity(constrained),before*.75+Vector3(.6,0,0),"deleted Hinge releases Capsule while Area stays active")
 check(pose(constrained).is_finite() and velocity(constrained).is_finite(),"combined state finite after clear readd delete")
 # Delete the field: both bodies now receive authored world gravity and defaults.
 PhysicsServer3D.free_rid(area);resources.erase(area)
 before=velocity(constrained);await step(1)
 near(velocity(constrained),before*(1-.006)+Vector3(0,-.1,0),"deleting Capsule Area restores world gravity and default damping")
 await finish("BACKEND_CROSS_RESULT")
