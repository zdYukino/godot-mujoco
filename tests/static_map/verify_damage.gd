extends SceneTree
const Package = preload("res://addons/godot_mujoco/map/package.gd")
func _initialize():
	var source := FileAccess.get_file_as_string("res://saved_path.txt").strip_edges()
	var target := "res://damaged"
	DirAccess.make_dir_recursive_absolute(target)
	DirAccess.copy_absolute(source.path_join("manifest.json"),target.path_join("manifest.json"))
	var missing := Package.validate(target)
	assert(missing.contains("缺少地图依赖"))
	var f := FileAccess.open(target.path_join("map.tscn"),FileAccess.WRITE); f.store_string("tampered"); f.close()
	var damaged := Package.validate(target)
	assert(damaged.contains("哈希不匹配"))
	assert(Package.validate(source).is_empty())
	var original := FileAccess.get_file_as_string(source.path_join("map.tscn"))
	var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(source.path_join("manifest.json")))
	f = FileAccess.open(target.path_join("map.tscn"),FileAccess.WRITE); f.store_string(original.replace('[node name="Visual"','[node name="MissingVisual"')); f.close()
	manifest.files["map.tscn"] = FileAccess.get_sha256(target.path_join("map.tscn"))
	f = FileAccess.open(target.path_join("manifest.json"),FileAccess.WRITE); f.store_string(JSON.stringify(manifest)); f.close()
	assert(Package.validate(target).contains("结构"))
	f = FileAccess.open(target.path_join("map.tscn"),FileAccess.WRITE); f.store_string(original.replace('path="res://addons/godot_mujoco/map/map_camera.gd"','path="res://unlisted_missing.gd"')); f.close()
	manifest.files["map.tscn"] = FileAccess.get_sha256(target.path_join("map.tscn"))
	f = FileAccess.open(target.path_join("manifest.json"),FileAccess.WRITE); f.store_string(JSON.stringify(manifest)); f.close()
	assert(Package.validate(target).contains("外部依赖"))
	var camera := "res://addons/godot_mujoco/map/map_camera.gd"
	assert(DirAccess.rename_absolute(camera,camera+".offline")==OK)
	var actual_missing := Package.validate(source)
	assert(DirAccess.rename_absolute(camera+".offline",camera)==OK)
	assert(actual_missing.contains("缺少实际场景依赖"))
	print("STATIC_MAP_DAMAGE 6 passed"); quit()
