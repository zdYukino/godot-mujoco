# Local toolchain, downloads, environment configuration and user projects
/third_party/
/projects/
.vscode/

# CMake build trees
/build/
/build-release/
/build-android/
/build-ios/
/build-from-source/

# Godot import cache
/examples/**/.godot/
/examples/**/.godot.*/
# Regenerated example script/shader IDs; keep IDs referenced by the G1 scene
/examples/**/*.uid
!/examples/g1_passive/g1_camera.gd.uid
!/examples/g1_passive/g1_controls.gd.uid
# Default OBJ import metadata; retain configured imports such as HDR settings
/examples/pendulum/models/composite/assets/box.obj.import
/examples/sdf_terrain/assets/terrain.obj.import
/examples/**/addons
/examples/pendulum/assets
/examples/**/bin/
/examples/**/obj/
__pycache__/
*.pyc

# Built + bundled binaries (produced by the CMake build, not source)
/addons/godot_mujoco/bin/*.so
/addons/godot_mujoco/bin/*.so.*
/addons/godot_mujoco/bin/*.dylib
/addons/godot_mujoco/bin/*.dll
/addons/godot_mujoco/bin/*.a
/addons/godot_mujoco/bin/gmj_core_smoke
/addons/godot_mujoco/bin/libc++_shared.so
/addons/godot_mujoco/bin/*.framework/

# Local validation outputs and .NET build artifacts
/build-*/
/**/bin/Debug/
/**/bin/Release/
/**/obj/
