  "fixes_verified": [
    "Renderer-completion callback disable/reentrant request lifetime safety",
    "Partial authored UI remains optional, 12 saved inherited variants",
    "Named abstract shared base restores public components in actual CreateDialog",
    "Conditional SubViewport target FPS unavailable explicitly, host FPS not misreported as target",
    "Shared keyboard-owner scope for original/Extras peers; root-only mouse ownership; disabled/freed owner fallback"
  ],
  "excluded_iterations": [
    "split-freebase-godot-final-1: relative OUT invocation; output write failure and GUI timeout, not accepted",
    "split-bindings-native-final-2: wrapper rejected script errors despite assertion summary; fixture now waits for both rendered frame and 5Hz widget readiness; final3 passes",
    "split-entries-headless-1: freed Binding provider reference errors; fixed, graphical final1 passes",
    "split-freebase-native-final-1: intermittent F11 reopen timeout after original Run/Pause, actual native active and logs clean; unchanged retry final2 passed, missing shared keyboard-owner scope then fixed",
    "split-keyboard-headless-1: assertions152/0 but wrapper rejected missing-meta diagnostics; has_meta guard fixed, current graphical supplement required"
  ],
  "limitations": [
    "Godot controls adapt pinned MuJoCo simulate definitions; no GLFW simulate main loop is embedded.",
    "Conditional SubViewport update modes have no reliable target draw count; HUD identifies host FPS and unavailable target FPS.",
    "Native actual activity is required; fallback never counts as native success. Existing platform/model/resource budgets remain unchanged.",
    "Short paused capped samples are not uncapped throughput, backend superiority or proof of long-term leak freedom.",
    "Raw build evidence is local; public record retains exact report and source-manifest hashes."
  ],
  "performance_note": "Eight modes,90 host interval samples each,120FPS cap,VSync off,paused physics. Absent mode removes original node and disables Extras (both inactive); cached presentation metadata is not live allocation count.",
