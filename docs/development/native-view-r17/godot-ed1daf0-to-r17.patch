+namespace {
+Vector<Ref<Image>> snapshot_texture_images(const Vector<Ref<Image>> &p_images) {
+	Vector<Ref<Image>> snapshots;
+	snapshots.resize(p_images.size());
+	for (int i = 0; i < p_images.size(); ++i) {
+		if (p_images[i].is_valid()) {
+			snapshots.write[i] = p_images[i]->duplicate();
+		}
+	}
+	return snapshots;
+}
