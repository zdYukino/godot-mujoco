+// An asynchronous upload owns an Image snapshot, not a reference to the caller's
+// mutable Image. Pixel storage remains COW-shared until either side writes.
+// The caller must still serialize its own concurrent writes during this call.
+RID RenderingServerDefault::texture_2d_create(const Ref<Image> &p_image) {
+	RID ret = RSG::texture_storage->texture_allocate();
+	if (Thread::get_caller_id() == server_thread || RSG::rasterizer->can_create_resources_async()) {
+		RSG::texture_storage->texture_2d_initialize(ret, p_image);
+	} else {
+		Ref<Image> snapshot;
+		if (p_image.is_valid()) {
+			snapshot = p_image->duplicate();
+		}
+		command_queue.push(RSG::texture_storage, &RendererTextureStorage::texture_2d_initialize, ret, snapshot);
+	}
+	return ret;
+}
+
+void RenderingServerDefault::texture_2d_update(RID p_texture, const Ref<Image> &p_image, int p_layer) {
+	redraw_request();
+	if (Thread::get_caller_id() != server_thread) {
+		Ref<Image> snapshot;
+		if (p_image.is_valid()) {
+			snapshot = p_image->duplicate();
+		}
+		command_queue.push(RSG::texture_storage, &RendererTextureStorage::texture_2d_update, p_texture, snapshot, p_layer);
+	} else {
+		command_queue.flush_if_pending();
+		RSG::texture_storage->texture_2d_update(p_texture, p_image, p_layer);
+	}
+}
